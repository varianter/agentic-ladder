{
  "name": "agentic-ladder",
  "version": "1.0.0",
  "private": true,
  "description": "Variant's agentic AI roadmap: interview data, the four-level model and the interactive ladder page.",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sirv src --dev --host 127.0.0.1 --port 4173",
    "build:llm": "node scripts/build-llm.mjs",
    "check:model": "node scripts/check-model.mjs && node scripts/build-llm.mjs --check",
    "check:types": "tsc -p .",
    "a11y": "node scripts/a11y.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome ci . && tsc -p . && node scripts/check-model.mjs && node scripts/build-llm.mjs --check && node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "ajv": "8.17.1",
    "axe-core": "4.10.2",
    "lit-html": "3.3.3",
    "puppeteer-core": "23.10.4",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1",
    "typescript": "7.0.2"
  }
}
